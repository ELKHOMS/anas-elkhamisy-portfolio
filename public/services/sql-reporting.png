<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 420" width="1200" height="420" font-family="ui-monospace,Menlo,Consolas,monospace" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
<defs>
<radialGradient id="glow" cx="75%" cy="20%" r="70%"><stop offset="0" stop-color="#f97316" stop-opacity="0.22"/><stop offset="1" stop-color="#f97316" stop-opacity="0"/></radialGradient>
<pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#ffffff" stroke-opacity="0.04"/></pattern>
<linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f97316" stop-opacity="0.45"/><stop offset="1" stop-color="#f97316" stop-opacity="0"/></linearGradient>
</defs>
<rect width="1200" height="420" fill="#15110e"/><rect width="1200" height="420" fill="url(#grid)"/><rect width="1200" height="420" fill="url(#glow)"/>
<rect x="60" y="40" width="600" height="340" rx="14" fill="#1a1511" stroke="#3a2f27"/>
<circle cx="86" cy="64" r="5" fill="#ef4444"/><circle cx="104" cy="64" r="5" fill="#f59e0b"/><circle cx="122" cy="64" r="5" fill="#22c55e"/>
<text x="150" y="69" fill="#78716c" font-size="13">query.sql</text>
<g font-size="18" fill="#e7e5e4">
<text x="90" y="116"><tspan fill="#f97316">SELECT</tspan> region,</text>
<text x="90" y="148">       <tspan fill="#fbbf24">SUM</tspan>(sales) <tspan fill="#f97316">AS</tspan> revenue</text>
<text x="90" y="180"><tspan fill="#f97316">FROM</tspan>   orders o</text>
<text x="90" y="212"><tspan fill="#f97316">JOIN</tspan>   customers c</text>
<text x="90" y="244">  <tspan fill="#f97316">ON</tspan>   o.cid = c.id</text>
<text x="90" y="276"><tspan fill="#f97316">GROUP BY</tspan> region</text>
<text x="90" y="308"><tspan fill="#f97316">ORDER BY</tspan> revenue <tspan fill="#f97316">DESC</tspan>;</text>
</g>
<rect x="706" y="40" width="440" height="340" rx="14" fill="#1a1511" stroke="#3a2f27"/>
<rect x="706" y="40" width="440" height="48" rx="14" fill="#2a221c"/>
<g font-size="16"><text x="730" y="71" fill="#d6d3d1">region</text><text x="930" y="71" fill="#d6d3d1">revenue</text></g>
<g font-size="17" fill="#e7e5e4">
<text x="730" y="124">Cairo</text><rect x="930" y="108" width="180" height="22" rx="4" fill="#f97316"/><text x="940" y="125" fill="#15110e" font-weight="bold">128K</text>
<text x="730" y="176">Alexandria</text><rect x="930" y="160" width="132" height="22" rx="4" fill="#f97316" fill-opacity="0.8"/><text x="940" y="177" fill="#15110e" font-weight="bold">94K</text>
<text x="730" y="228">Delta</text><rect x="930" y="212" width="86" height="22" rx="4" fill="#f97316" fill-opacity="0.65"/><text x="940" y="229" fill="#15110e" font-weight="bold">61K</text>
<text x="730" y="280">Upper Egypt</text><rect x="930" y="264" width="54" height="22" rx="4" fill="#f97316" fill-opacity="0.5"/><text x="940" y="281" fill="#15110e" font-weight="bold">38K</text>
</g>
<text x="730" y="352" fill="#4ade80" font-size="14">✓ 4 rows returned</text>
</svg>
